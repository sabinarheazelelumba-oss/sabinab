# Copy this file to .env and fill in the values  (.env is git-ignored, never commit it)

# Application Settings
APP_NAME=ProductManagementAPI
APP_KEY=
APP_ENV=development

# Migrations: set to true only while you run "php lava migration ..." (keep false on Render)
MIGRATION_ENABLED=true

# CORS: your frontend URL (several allowed, comma-separated). * = allow all (OK for local testing)
ALLOW_ORIGIN=*

# Database Configuration (Aiven MySQL -> Overview page -> Connection information)
DB_DRIVER=mysql
DB_HOST=your-service-name-your-project.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires SSL. Download "CA certificate" from the Aiven console, save it as ca.pem
# in the project root, then keep these two lines.
DB_SSL=true
DB_SSL_CA=ca.pem
# On Render you can instead paste the certificate text into DB_SSL_CA_CONTENT
# DB_SSL_CA_CONTENT=
# false = encrypted connection, certificate not verified (works out of the box on Aiven).
# true  = also verify the server certificate against ca.pem (more secure; needs a valid ca.pem).
DB_SSL_VERIFY=false

# For API (generate both with:  php lava jwt:generate --show )
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Optional: password of the seeded admin@example.com account (default: Admin@12345)
SEED_ADMIN_PASSWORD=
